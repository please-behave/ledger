{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attestation",
  "description": "One stored attestation with its summary fields, bound Rule Sets and results.",
  "type": "object",
  "required": [
    "results",
    "rule_sets"
  ],
  "allOf": [
    {
      "$ref": "#/$defs/summary"
    }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "id",
        "received_at",
        "sender",
        "repository",
        "commit",
        "execution_points",
        "overall",
        "warn_count",
        "not_run_count",
        "result_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The attestation's UUID."
        },
        "received_at": {
          "type": "string",
          "description": "When the ledger received it, as an RFC 3339 UTC timestamp."
        },
        "sender": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "execution_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overall": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR"
          ]
        },
        "warn_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of results with status WARN."
        },
        "not_run_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of results with status NOT_RUN."
        },
        "result_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of results the attestation holds."
        }
      }
    }
  },
  "properties": {
    "rule_sets": {
      "type": "array",
      "description": "Stored Rule Set bindings in reported order, or an empty array when none were stored.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "path", "id", "version", "execution_points"],
        "properties": {
          "source": { "type": "string" },
          "path": { "type": "string" },
          "id": { "type": "string", "description": "The Rule Set's local ID." },
          "version": { "type": "string" },
          "execution_points": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "The stored name of the matching registered rule version, when available."
          },
          "rule": {
            "type": "object",
            "description": "The reported rule identity, when stored.",
            "additionalProperties": false,
            "required": ["source", "path", "id"],
            "properties": {
              "source": { "type": "string" },
              "path": { "type": "string" },
              "id": { "type": "string", "description": "The rule's local ID." },
              "version": { "type": "string" }
            }
          },
          "kind": {
            "enum": [
              "check",
              "review",
              "integrity"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "NOT_RUN",
              "WARN"
            ]
          },
          "verification": {
            "type": "object",
            "oneOf": [
              {
                "additionalProperties": false,
                "required": ["status"],
                "properties": {
                  "status": { "const": "verified" }
                }
              },
              {
                "additionalProperties": false,
                "required": ["status", "reason"],
                "properties": {
                  "status": { "const": "unverified" },
                  "reason": { "enum": ["unregistered", "mismatch"] }
                }
              }
            ]
          }
        }
      }
    }
  }
}
