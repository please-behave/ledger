{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registered rules",
  "type": "array",
  "items": {
    "$ref": "#/$defs/summary",
    "required": ["scan"],
    "properties": {
      "scan": { "$ref": "#/$defs/scan" }
    },
    "unevaluatedProperties": false
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "id", "version", "scan"],
      "properties": {
        "source": { "$ref": "#/$defs/summary/properties/source" },
        "path": { "$ref": "#/$defs/summary/properties/path" },
        "id": { "$ref": "#/$defs/summary/properties/id" },
        "version": { "$ref": "#/$defs/summary/properties/version" },
        "scan": { "$ref": "#/$defs/scan" }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["through", "registrations"],
      "properties": {
        "through": { "type": "integer" },
        "registrations": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["source", "path", "id", "version", "kind"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "kind": { "enum": ["check", "review"] },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
