{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registered rule versions",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "rules.schema.json#/$defs/summary",
    "unevaluatedProperties": false,
    "required": ["digest", "commit", "registered_at"],
    "properties": {
      "blocking": { "type": "boolean" },
      "prompt": { "type": "string" },
      "knowledge": { "type": "object" },
      "digest": { "type": "string", "pattern": "^v1:sha256:[0-9a-f]{64}(?![\\s\\S])" },
      "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" },
      "registered_at": { "type": "string", "format": "date-time" }
    },
    "if": { "properties": { "kind": { "const": "review" } } },
    "then": { "required": ["blocking", "prompt"] },
    "else": { "not": { "anyOf": [{ "required": ["blocking"] }, { "required": ["prompt"] }] } }
  }
}
