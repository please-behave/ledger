{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release fact request",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "version", "commit", "sender", "auth_method"],
  "properties": {
    "repository": { "$ref": "#/$defs/text", "maxLength": 256 },
    "version": { "$ref": "#/$defs/text", "maxLength": 256 },
    "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" },
    "sender": { "$ref": "#/$defs/text" },
    "auth_method": { "enum": ["api_key", "github_oidc"] }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } }
  }
}
