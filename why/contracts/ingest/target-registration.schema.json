{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Register deployment targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["sender", "targets"],
  "properties": {
    "sender": { "$ref": "#/$defs/text", "minLength": 1, "maxLength": 256 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
          },
          "description": { "$ref": "#/$defs/text", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "not": { "pattern": "\\u0000" }
    }
  }
}
