{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment fact request",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "repository", "sender", "auth_method"],
  "oneOf": [{ "required": ["version"] }, { "required": ["commit"] }],
  "properties": {
    "target": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])" },
    "repository": { "$ref": "#/$defs/key" },
    "version": { "$ref": "#/$defs/key" },
    "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" },
    "sender": { "$ref": "#/$defs/key" },
    "auth_method": { "enum": ["api_key", "github_oidc"] }
  },
  "$defs": {
    "key": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\\u0000" } }
  }
}
