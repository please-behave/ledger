{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Register Rule Set versions",
  "type": "object",
  "additionalProperties": false,
  "required": ["sender", "commit", "sets"],
  "properties": {
    "sender": { "$ref": "#/$defs/text", "minLength": 1 },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])"
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/set" }
    }
  },
  "$defs": {
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "id", "version", "members"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "path": { "$ref": "#/$defs/path" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "name": { "$ref": "#/$defs/text", "maxLength": 80 },
        "description": { "$ref": "#/$defs/text", "maxLength": 65536 },
        "knowledge": { "$ref": "#/$defs/knowledge" },
        "members": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/member" }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "id", "version", "digest", "enabled"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "path": { "$ref": "#/$defs/path" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": {
          "type": "string",
          "pattern": "^v1:sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "enabled": { "type": "boolean" }
      }
    },
    "source": {
      "$ref": "#/$defs/text",
      "maxLength": 256,
      "pattern": "^[^/@\\s]+/[^/\\\\\\u0000-\\u001f\\u007f]",
      "not": {
        "pattern": "(\\.git|/)(?![\\s\\S])|[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "path": {
      "$ref": "#/$defs/text",
      "minLength": 1,
      "maxLength": 256,
      "anyOf": [
        { "const": "." },
        {
          "not": {
            "pattern": "^[/\\\\]|^[A-Za-z]:|//|/(?![\\s\\S])|(^|/)\\.{1,2}(/|(?![\\s\\S]))"
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "not": { "pattern": "\\u0000" }
    },
    "knowledgeText": { "minLength": 1, "$ref": "#/$defs/text", "maxLength": 65536 },
    "knowledgeList": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "audience", "commonality", "rules", "admission", "execution_points"],
      "properties": {
        "purpose": { "$ref": "#/$defs/knowledgeText" },
        "audience": { "$ref": "#/$defs/knowledgeText" },
        "commonality": { "$ref": "#/$defs/knowledgeText" },
        "rules": {
          "$ref": "#/$defs/knowledgeList",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "role"],
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
                "$ref": "#/$defs/text"
              },
              "role": { "$ref": "#/$defs/knowledgeText" }
            }
          }
        },
        "admission": {
          "$ref": "#/$defs/knowledgeList",
          "items": { "$ref": "#/$defs/knowledgeText" }
        },
        "excluded": {
          "$ref": "#/$defs/knowledgeList",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "rationale"],
            "properties": {
              "description": { "$ref": "#/$defs/knowledgeText" },
              "rationale": { "$ref": "#/$defs/knowledgeText" },
              "ruleset": { "$ref": "#/$defs/knowledgeText" }
            }
          }
        },
        "complements": {
          "$ref": "#/$defs/knowledgeList",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleset", "rationale"],
            "properties": {
              "ruleset": { "$ref": "#/$defs/knowledgeText" },
              "rationale": { "$ref": "#/$defs/knowledgeText" }
            }
          }
        },
        "execution_points": { "$ref": "#/$defs/knowledgeText" },
        "references": {
          "$ref": "#/$defs/knowledgeList",
          "items": { "$ref": "#/$defs/knowledgeText" }
        }
      }
    }
  }
}
