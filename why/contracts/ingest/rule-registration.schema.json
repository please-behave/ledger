{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule registration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["sender", "commit", "rules"],
  "properties": {
    "sender": { "$ref": "#/$defs/text", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "path", "id", "version", "kind"],
        "properties": {
          "source": { "$ref": "#/$defs/text", "minLength": 1, "maxLength": 256 },
          "path": { "$ref": "#/$defs/text", "minLength": 1, "maxLength": 256 },
          "id": { "$ref": "#/$defs/text", "minLength": 1, "maxLength": 128 },
          "version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "kind": { "enum": ["check", "review"] },
          "name": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" },
          "blocking": { "type": "boolean" },
          "prompt": { "$ref": "#/$defs/text" },
          "knowledge": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/knowledgeValue" }
          }
        },
        "if": { "properties": { "kind": { "const": "review" } } },
        "then": { "required": ["blocking", "prompt"] },
        "else": { "not": { "anyOf": [{ "required": ["blocking"] }, { "required": ["prompt"] }] } }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "not": { "pattern": "\\u0000" } },
    "knowledgeValue": {
      "oneOf": [
        { "type": ["string", "boolean"] },
        { "type": "array", "items": { "$ref": "#/$defs/knowledgeValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/knowledgeValue" } }
      ]
    }
  }
}
