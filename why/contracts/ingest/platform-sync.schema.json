{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform sync request",
  "type": "object",
  "additionalProperties": false,
  "required": ["sender", "platform", "host", "scope", "completed_at", "inventory", "heads"],
  "properties": {
    "sender": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s\\u0000]+(?![\\s\\S])" },
    "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])" },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?![\\s\\S])"
    },
    "scope": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}/)[A-Za-z0-9_.-]{1,128}/(?!\\.{1,2}(?![\\s\\S]))(?:\\*|[A-Za-z0-9_.-]{1,128})(?![\\s\\S])"
    },
    "completed_at": { "$ref": "#/$defs/timestamp" },
    "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventory-entry" } },
    "heads": { "type": "array", "items": { "$ref": "#/$defs/head-observation" } }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "not": { "enum": [".", ".."] }
    },
    "branch": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\s\\u0000]+(?![\\s\\S])" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "inventory-entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_branch", "archived", "fork", "last_activity_at"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "default_branch": { "$ref": "#/$defs/branch" },
        "archived": { "type": "boolean" },
        "fork": { "type": "boolean" },
        "last_activity_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "head-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "branch", "commit_sha", "committed_at", "observed_at"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "branch": { "$ref": "#/$defs/branch" },
        "commit_sha": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" },
        "committed_at": { "$ref": "#/$defs/timestamp" },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
